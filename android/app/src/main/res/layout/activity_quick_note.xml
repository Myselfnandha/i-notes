<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:gravity="center">

    <!-- Floating Stationery Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_quick_note_card"
        android:padding="20dp"
        android:elevation="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/btn_save_ochre"
                android:text="i"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:gravity="center"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant Quick Note"
                    android:textColor="@color/colorInk"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direct to Archival Vault"
                    android:textColor="@color/colorInkMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_widget_close"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Note Title Input -->
        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title (optional)..."
            android:textColorHint="@color/colorInkLight"
            android:textColor="@color/colorInk"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@null"
            android:layout_marginBottom="8dp"
            android:maxLines="1"
            android:inputType="textCapSentences" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8E2D8"
            android:layout_marginBottom="10dp" />

        <!-- Note Content Input (Auto-focused with keyboard) -->
        <EditText
            android:id="@+id/input_note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="110dp"
            android:gravity="top|start"
            android:hint="Type your thought, outline, or reflection..."
            android:textColorHint="@color/colorInkLight"
            android:textColor="@color/colorInk"
            android:textSize="14sp"
            android:background="@null"
            android:lineSpacingExtra="4dp"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Action Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/colorInkMuted"
                android:textSize="13sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_save_note"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Save to Vault"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="@drawable/btn_save_ochre"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
