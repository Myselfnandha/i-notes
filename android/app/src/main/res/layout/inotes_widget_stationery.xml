<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_stationery"
    android:padding="12dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <!-- Brand Monogram -->
        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/btn_save_ochre"
            android:text="i"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="i Notes"
            android:textColor="@color/colorInk"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" · ARCHIVAL"
            android:textColor="@color/colorInkLight"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● READY"
            android:textColor="@color/colorPrimary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Blank Ruled Typing Area (Tapping this triggers Instant Keyboard Quick-Add) -->
    <LinearLayout
        android:id="@+id/widget_blank_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_typing_area"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_prompt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Write a reflection or thought..."
            android:textColor="@color/colorInkMuted"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Ruled notebook guide line using FrameLayout (RemoteViews-compliant) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFEBE4"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/widget_last_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pristine sheet · Tap anywhere to type instantly"
            android:textColor="@color/colorInkLight"
            android:textSize="11sp"
            android:maxLines="2" />
    </LinearLayout>

    <!-- Bottom Quick Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_btn_new_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_save_ochre"
            android:text="+ Quick Note"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />

        <!-- RemoteViews-compliant spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_btn_open_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Notes →"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>
</LinearLayout>
